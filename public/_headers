# Cloudflare Pages headers.
# The broad rule comes first; the specific ones after it win where they match.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The bundle filenames carry a hash, so they can be cached forever.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# This is the file the app polls to notice a new deploy. It must never be cached.
/version.json
  Cache-Control: no-store
